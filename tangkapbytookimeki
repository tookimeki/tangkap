local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local isAnimating = false

local function MaximizeGUI()
    if isAnimating then return end
    isAnimating = true

    local targetX = OpenBtn.Position.X.Offset + 45
    local targetY = OpenBtn.Position.Y.Offset + 50
    local viewport = workspace.CurrentCamera.ViewportSize
    if viewport.X > 0 and viewport.Y > 0 then
        targetX = math.clamp(targetX, 300, viewport.X)
        targetY = math.clamp(targetY, 55, viewport.Y - 55)
    end
    
    TweenService:Create(OpenBtn, tweenInfo, {Size = UDim2.new(0, 0, 0, 0)}):Play()
    task.wait(0.3)
    
    OpenBtn.Visible = false
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0, targetX, 0, targetY)
    MainFrame.Visible = true
    
    TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 300, 0, 110)}):Play()
    task.wait(0.3)
