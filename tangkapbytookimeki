-- 4. LOGIKA AUTO-FARM (PHYSICAL VIM BYPASS)
-- ==========================================
local autoFarmActive = false
local loopRunning = true

-- Fungsi untuk mengkalkulasi koordinat dan mengirimkan klik fisik seolah-olah dari mouse asli
local function PhysicalClick(guiObject)
    if not guiObject then return end
    
    -- Kalkulasi Titik Tengah Tombol
    local absPos = guiObject.AbsolutePosition
    local absSize = guiObject.AbsoluteSize
    
    -- Mengambil Inset dari Topbar Roblox untuk akurasi sumbu Y
    local inset = GuiService:GetGuiInset()
    
    local x = absPos.X + (absSize.X / 2)
    local y = absPos.Y + (absSize.Y / 2) + inset.Y
    
    -- Simulasi Hardware: Mouse Ditekan (Mensimulasikan image_e4d799.png)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.05) -- Jeda mekanis
    -- Simulasi Hardware: Mouse Dilepas
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

-- LOOP UTAMA DENGAN STATE MACHINE 1-CLICK
task.spawn(function()
    while loopRunning do
        task.wait(0.1) 
        
        if autoFarmActive then
            -- A. PASTIKAN JARING DIPEGANG TERUS
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local jaring = LocalPlayer.Backpack:FindFirstChild("Jaring") or character:FindFirstChild("Jaring")
                
                if jaring and jaring.Parent ~= character then
                    if humanoid then humanoid:EquipTool(jaring) end
                end
            end
            
            -- B. PINDAI LAYAR
            local insectFound = nil
            local catchBtnFound = nil
            
            for _, gui in pairs(PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled then
                    
                    if not catchBtnFound then
                        local btn = gui:FindFirstChild("CatchButton", true)
                        if btn and btn:IsA("GuiButton") and btn.Visible then
                            catchBtnFound = btn
                        end
                    end
                    
                    if not insectFound then
                        local insect = gui:FindFirstChild("Dragonfly", true) or 
                                       gui:FindFirstChild("Butterfly", true) or 
                                       gui:FindFirstChild("Frog", true)
                        if insect and insect:IsA("GuiButton") and insect.Visible then
                            insectFound = insect
                        end
                    end
                    
                end
            end
            
            -- C. EKSEKUSI KLIK FISIK (VIM)
            if insectFound then
                -- Jika serangga di minigame muncul, klik fisiknya
                PhysicalClick(insectFound)
                task.wait(0.5) -- Jeda setelah menangkap agar GUI sempat tertutup
            else
                if catchBtnFound then
                    -- Klik fisik tombol hijau
                    PhysicalClick(catchBtnFound)
                    
                    -- Kunci skrip selama 2 detik agar tidak spamming tombol hijau yang sama,
                    -- memberi waktu minigame capung untuk muncul di layar.
                    task.wait(2)
                end
            end
            
        end
    end
end)

