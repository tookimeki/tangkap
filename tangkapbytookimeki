-- 2. SISTEM CUSTOM DRAG
-- ==========================================
local function MakeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if guiObject == MainFrame and ToggleBtn.IsHovered then return end 
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position 
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local targetX = startPos.X.Offset + delta.X
            local targetY = startPos.Y.Offset + delta.Y
            local viewport = workspace.CurrentCamera.ViewportSize
            local apX, apY = guiObject.AnchorPoint.X, guiObject.AnchorPoint.Y
            local sizeX, sizeY = guiObject.AbsoluteSize.X, guiObject.AbsoluteSize.Y
            local minX, maxX = sizeX * apX, viewport.X - sizeX * (1 - apX)
            local minY, maxY = sizeY * apY, viewport.Y - sizeY * (1 - apY)
            if viewport.X > 0 and viewport.Y > 0 then
                targetX = math.clamp(targetX, minX, maxX)
                targetY = math.clamp(targetY, minY, maxY)
            end
            guiObject.Position = UDim2.new(0, targetX, 0, targetY)
        end
    end)
end
MakeDraggable(MainFrame)
MakeDraggable(OpenBtn)

