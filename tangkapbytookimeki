-- ==========================================
-- AUTO-FARM SERANGGA (Versi Dasar)
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Fungsi virtual clicker menggunakan metode getconnections (Khusus Executor)
local function VirtualClick(button)
    if not button then return end
    
    -- Mencoba memicu event klik kiri
    if getconnections then
        for _, connection in pairs(getconnections(button.MouseButton1Click)) do
            connection:Fire()
        end
        for _, connection in pairs(getconnections(button.MouseButton1Down)) do
            connection:Fire()
        end
    end
end

-- Sistem Radar: Memantau setiap GUI baru yang masuk ke layar Anda
PlayerGui.ChildAdded:Connect(function(gui)
    
    -- 1. Deteksi Tombol Pemicu Awal
    if gui.Name == "DragonflyCatchGui" then
        -- Menunggu tombol CatchButton muncul (maksimal 3 detik)
        local catchBtn = gui:WaitForChild("CatchButton", 3)
        if catchBtn then
            task.wait(0.1) -- Jeda sangat singkat agar tidak dicurigai server
            VirtualClick(catchBtn)
        end
    end
    
    -- 2. Deteksi Minigame Utama
    if gui.Name == "DragonflyMinigameGui" then
        local gameArea = gui:WaitForChild("GameArea", 3)
        if gameArea then
            -- Mencari tombol capungnya
            local dragonflyBtn = gameArea:WaitForChild("Dragonfly", 3)
            if dragonflyBtn then
                task.wait(0.2) -- Menunggu bar hijau (TimerBg) ter-load
                VirtualClick(dragonflyBtn)
                print("[Auto-Farm]: Berhasil menangkap Capung!")
            end
        end
    end
    
end)

print("Sistem Auto-Catch Serangga Aktif!")
