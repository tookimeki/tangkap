-- ==========================================
-- 4. LOGIKA AUTO-FARM (STATE MACHINE MURNI)
-- ==========================================
local autoFarmActive = false
local loopRunning = true

-- Status Mesin: "CARI_TOMBOL_HIJAU" atau "TUNGGU_MINIGAME"
local currentState = "CARI_TOMBOL_HIJAU" 
local timeWaitingStarted = 0

-- Fungsi Nuke Clicker (Memicu seluruh event klik agar tidak meleset)
local function VirtualClick(button)
    if not button then return end
    if getconnections then
        pcall(function()
            for _, connection in pairs(getconnections(button.MouseButton1Down)) do connection:Fire() end
            for _, connection in pairs(getconnections(button.MouseButton1Click)) do connection:Fire() end
            for _, connection in pairs(getconnections(button.MouseButton1Up)) do connection:Fire() end
            for _, connection in pairs(getconnections(button.Activated)) do connection:Fire() end
        end)
    end
end

-- LOOP UTAMA (Memindai 10x per detik)
task.spawn(function()
    while loopRunning do
        task.wait(0.1) 
        
        if autoFarmActive then
            -- A. PASTIKAN JARING SELALU DIPEGANG
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local jaring = LocalPlayer.Backpack:FindFirstChild("Jaring") or character:FindFirstChild("Jaring")
                
                if jaring and jaring.Parent ~= character then
                    if humanoid then humanoid:EquipTool(jaring) end
                end
            end
            
            -- B. PINDAI LAYAR
            local insectFound = nil
            local catchBtnFound = nil
            
            for _, gui in pairs(PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled then
                    
                    -- Cari Serangga
                    if not insectFound then
                        local insect = gui:FindFirstChild("Dragonfly", true) or 
                                       gui:FindFirstChild("Butterfly", true) or 
                                       gui:FindFirstChild("Frog", true)
                        if insect and insect:IsA("GuiButton") and insect.Visible then
                            insectFound = insect
                        end
                    end
                    
                    -- Cari Tombol Hijau
                    if not catchBtnFound then
                        local btn = gui:FindFirstChild("CatchButton", true)
                        if btn and btn:IsA("GuiButton") and btn.Visible then
                            catchBtnFound = btn
                        end
                    end
                end
            end
            
            -- C. EKSEKUSI BERDASARKAN STATUS (STATE MACHINE)
            if currentState == "CARI_TOMBOL_HIJAU" then
                -- Jika tombol hijau muncul, klik SEKALI dan ganti status!
                if catchBtnFound then
                    VirtualClick(catchBtnFound)
                    currentState = "TUNGGU_MINIGAME"
                    timeWaitingStarted = os.clock()
                end
                
            elseif currentState == "TUNGGU_MINIGAME" then
                -- Dalam status ini, skrip MENGABAIKAN tombol hijau sepenuhnya (Tidak akan looping)
                
                if insectFound then
                    -- Serangga muncul! Tangkap!
                    VirtualClick(insectFound)
                    
                    -- Setelah berhasil ditangkap, kembali ke status awal untuk mencari tombol hijau lagi
                    currentState = "CARI_TOMBOL_HIJAU"
                    task.wait(0.5) -- Jeda istirahat agar tidak terlalu agresif
                else
                    -- FAILSAFE: Jika skrip sudah menunggu selama 6 detik tapi serangga tidak muncul
                    -- (Mungkin karena nge-bug atau serangganya kabur), kembalikan status ke awal.
                    if os.clock() - timeWaitingStarted > 6 then
                        currentState = "CARI_TOMBOL_HIJAU"
                    end
                end
            end
            
        end
    end
end)

