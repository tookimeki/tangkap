-- LOGIKA AUTO-FARM
-- ==========================================
local autoFarmActive = false

-- Fungsi Virtual Clicker (Mengeklik tombol GUI secara paksa)
local function VirtualClick(button)
    if not button then return end
    if getconnections then
        for _, connection in pairs(getconnections(button.MouseButton1Click)) do
            connection:Fire()
        end
        for _, connection in pairs(getconnections(button.MouseButton1Down)) do
            connection:Fire()
        end
    end
end

-- Sistem Radar: Memantau GUI Minigame
PlayerGui.ChildAdded:Connect(function(gui)
    if not autoFarmActive then return end -- Abaikan jika Auto-Farm sedang OFF

    -- Deteksi CatchGui (Trigger Awal)
    if string.find(gui.Name, "CatchGui") then
        local catchBtn = gui:WaitForChild("CatchButton", 2)
        if catchBtn then
            task.wait(0.1)
            VirtualClick(catchBtn)
        end
    end
    
    -- Deteksi MinigameGui (Capung, Kupu-kupu, Kodok)
    if string.find(gui.Name, "MinigameGui") then
        local gameArea = gui:WaitForChild("GameArea", 2)
        if gameArea then
            -- Mencari tombol serangga berdasarkan tipe
            local insectBtn = gameArea:FindFirstChild("Dragonfly") or 
                              gameArea:FindFirstChild("Butterfly") or 
                              gameArea:FindFirstChild("Frog")
                              
            if insectBtn then
                task.wait(0.2)
                VirtualClick(insectBtn)
            end
        end
    end
end)

-- Loop Utama: Memegang dan Mengayunkan Jaring
task.spawn(function()
    while task.wait(0.5) do -- Eksekusi setiap setengah detik
        if autoFarmActive then
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                -- Mencari Jaring di tas atau yang sedang dipegang
                local jaring = LocalPlayer.Backpack:FindFirstChild("Jaring") or character:FindFirstChild("Jaring")
                
                if jaring then
                    -- Jika jaring belum dipegang, paksa untuk dipegang
                    if jaring.Parent ~= character then
                        humanoid:EquipTool(jaring)
                        task.wait(0.2) -- Jeda sebentar agar animasi equip selesai
                    end
                    
                    -- Ayunkan jaring secara otomatis
                    jaring:Activate()
                end
            end
        end
    end
end)

